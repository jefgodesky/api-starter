{
  "tasks": {
    "start": "deno run --allow-net --allow-env --allow-read main.ts",
    "listen": "deno run --watch --allow-net --allow-env --allow-read main.ts",
    "dev": "./docker/dev/cmd.sh",
    "dev:stop": "./docker/dev/cmd.sh down",
    "pre-commit": "deno fmt && deno lint && deno run test",
    "test": "LANG=en-us deno test --allow-env --allow-read",
    "test:full": "./docker/test/cmd.sh"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "hono/jsx"
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true,
    "trailingCommas": "never"
  },
  "imports": {
    "@hono/hono": "jsr:@hono/hono@^4.13.13",
    "@hono/zod-openapi": "jsr:@hono/zod-openapi@^1.6.3",
    "@revolutionarygamesco/common": "npm:@revolutionarygamesco/common@^1.3.4",
    "@std/expect": "jsr:@std/expect@^1.0.20",
    "@std/yaml": "jsr:@std/yaml@^1.3.0",
    "ts-japi": "npm:ts-japi@^1.12.6"
  }
}
