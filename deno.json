{
  "tasks": {
    "listen": "deno run --allow-net --allow-env --allow-read main.ts",
    "listen:dev": "deno run --watch --allow-net --allow-env --allow-read main.ts",
    "dev": "./env/dev.sh",
    "dev:stop": "./env/dev.sh down",
    "dev:start": "deno task listen:dev",
    "migrate": "deno run --allow-net --allow-env --allow-read db/migrate.ts",
    "start": "deno task listen",
    "test": "./env/test.sh",
    "test:unit": "deno test --allow-env",
    "precommit": "deno lint && deno fmt && deno run test"
  },
  "imports": {
    "@hono/zod-openapi": "jsr:@hono/zod-openapi@^1.6.3",
    "@revolutionarygamesco/common": "npm:@revolutionarygamesco/common@^1.3.2",
    "@std/assert": "jsr:@std/assert@1",
    "@std/collections": "jsr:@std/collections@^1.3.0",
    "@std/expect": "jsr:@std/expect@^1.0.20",
    "@std/uuid": "jsr:@std/uuid@^1.1.1",
    "hono": "jsr:@hono/hono@^4.13.5",
    "kysely": "npm:kysely@^0.29.5",
    "kysely-postgres-js": "npm:kysely-postgres-js@^4.0.0",
    "postgres": "npm:postgres@^3.4.9",
    "ts-japi": "npm:ts-japi@^1.12.5",
    "yaml": "npm:yaml@^2.9.0"
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true,
    "indentWidth": 2,
    "lineWidth": 80
  }
}
