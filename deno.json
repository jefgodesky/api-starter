{
  "imports": {
    "hono": "jsr:@hono/hono@^4.13.13"
  },
  "tasks": {
    "start": "deno run --allow-net main.ts",
    "pre-commit": "deno fmt && deno lint"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "hono/jsx"
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true,
    "trailingCommas": "never"
  }
}
