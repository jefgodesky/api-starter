{
  "tasks": {
    "start": "deno run --allow-net main.ts",
    "pre-commit": "deno fmt && deno lint"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "hono/jsx"
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true,
    "trailingCommas": "never"
  },
  "imports": {
    "@hono/zod-openapi": "jsr:@hono/zod-openapi@^1.6.3"
  }
}
