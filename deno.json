{
  "tasks": {
    "start": "deno run --allow-net main.ts",
    "pre-commit": "deno fmt && deno lint && deno run test",
    "test": "deno test --allow-env"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "hono/jsx"
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true,
    "trailingCommas": "never"
  },
  "imports": {
    "@hono/zod-openapi": "jsr:@hono/zod-openapi@^1.6.3",
    "@revolutionarygamesco/common": "npm:@revolutionarygamesco/common@^1.3.2",
    "@std/expect": "jsr:@std/expect@^1.0.20"
  }
}
