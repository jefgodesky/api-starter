{
  "name": "api-starter",
  "version": "1.0.0",
  "description": "A starting point for RESTful API projects that takes care of setting up environments, development patterns, users, and authentication in ways that make it easy to change and write high quality, reliable code.",
  "homepage": "https://github.com/jefgodesky/api-starter",
  "bugs": "https://github.com/jefgodesky/api-starter/issues",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "contributors": [
    {
      "name": "Jason Godesky",
      "email": "jason@godesky.net",
      "url": "https://jason.godesky.net"
    }
  ],
  "scripts": {
    "dev": "pnpm run dev:start",
    "dev:start": "./env/dev/cmd.sh",
    "dev:stop": "pnpm run dev down",
    "dev:restart": "pnpm run dev:stop && pnpm run dev",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:int": "./env/test/cmd.sh",
    "lint": "eslint ./src",
    "lint:fix": "pnpm run lint --fix"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/zod-openapi": "^1.6.3",
    "@loglayer/hono": "^2.4.0",
    "@loglayer/plugin-redaction": "^4.1.0",
    "@loglayer/transport-pino": "^3.3.0",
    "@revolutionarygamesco/common": "^1.4.1",
    "hono": "^4.13.13",
    "language-tags": "^2.1.0",
    "loglayer": "^9.4.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "serialize-error": "^13.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/language-tags": "^1.0.4",
    "@types/node": "^26.1.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "compose-spec-schema": "^1.0.0",
    "eslint": "^10.13.0",
    "lefthook": "^2.2.2",
    "neostandard": "^0.14.1",
    "tsx": "^4.23.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5"
  }
}