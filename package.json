    "start": "node dist/index.js",
    "test": "vitest run",
    "test:int": "./env/test/cmd.sh",
    "lint": "eslint .",
    "lint:fix": "pnpm run lint --fix"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/zod-openapi": "^1.6.3",
    "@revolutionarygamesco/common": "^1.4.0",
    "hono": "^4.13.13",
    "language-tags": "^2.1.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/language-tags": "^1.0.4",
    "@types/node": "^26.1.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "lefthook": "^2.2.2",
    "neostandard": "^0.14.1",
    "tsx": "^4.23.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5"
